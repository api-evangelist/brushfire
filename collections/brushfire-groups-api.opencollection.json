          "http": {
            "method": "GET",
            "url": "https://api.brushfire.com/groups/:groupId/fields",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "A GUID or an integer representing a group"
              },
              {
                "name": "accessKey",
                "value": "",
                "type": "query",
                "description": "The Access Key for the user context"
              }
