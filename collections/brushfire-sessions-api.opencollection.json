            "params": [
              {
                "name": "sessionId",
                "value": "",
                "type": "path",
                "description": "An integer representing the session to check into"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Check in one or more attendees for a specific session"
        },
